# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Data: conservar estructura, no publicar datos por defecto
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Referencias bibliográficas y documentos fuente privados
references/_private/
references/_private/**
references_private/
references_private/**
*.pdf
*.[pP][dD][fF]

# Artefactos de experimentos: pueden incluir datos experimentales privados
results/*
!results/.gitkeep
*.joblib
