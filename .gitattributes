# Auto detect text files and perform LF normalization
* text=auto

# Preserve exact bytes used by the EDA SHA-256 manifests across platforms.
data/raw/dati_campagna_venditti.m -text whitespace=cr-at-eol
data/interim/preliminary/** -text whitespace=cr-at-eol
data/processed/preliminary/** -text whitespace=cr-at-eol
config/data_schema.yml -text whitespace=cr-at-eol
src/eda_relaciones.py -text whitespace=cr-at-eol
reports/eda/** -text whitespace=cr-at-eol
reports/eda_calidad/** -text whitespace=cr-at-eol
reports/eda_relaciones/** -text whitespace=cr-at-eol
reports/eda_transformaciones/** -text whitespace=cr-at-eol

# Matplotlib SVG paths include harmless trailing spaces in generated geometry.
reports/**/figures/*.svg whitespace=-blank-at-eol,cr-at-eol

# Preserve new FE provenance artifacts and source hashes in Windows checkouts.
reports/feature_engineering/** -text whitespace=cr-at-eol
reports/feature_engineering/figures/*.svg whitespace=-blank-at-eol,cr-at-eol
config/feature_engineering.json -text whitespace=cr-at-eol
src/feature_engineering.py -text whitespace=cr-at-eol
src/experimentos_fe.py -text whitespace=cr-at-eol
src/informe_fe.py -text whitespace=cr-at-eol

# Preserve the executed tuning evidence and its SHA-256 checks on all platforms.
config/ajuste_modelos.json -text whitespace=cr-at-eol
reports/modelos_ajustados/** -text whitespace=cr-at-eol
reports/modelos_ajustados/figures/*.svg whitespace=-blank-at-eol,cr-at-eol

# Preserve byte-level manifests of the permutation activity in fresh checkouts.
reports/permutation_importance/** -text whitespace=cr-at-eol
reports/permutation_importance/figures/*.svg whitespace=-blank-at-eol,cr-at-eol
config/comparacion_modelos.json -text whitespace=cr-at-eol
config/criterios_entrega_permutacion.json -text whitespace=cr-at-eol
docs/matriz_consistencia.csv -text whitespace=cr-at-eol
notebooks/06_Modelado_Tuning_SHAP.ipynb -text whitespace=cr-at-eol
src/ajuste_modelos.py -text whitespace=cr-at-eol
src/transformaciones_eda.py -text whitespace=cr-at-eol
src/importancia_permutacion.py -text whitespace=cr-at-eol
src/figuras_permutacion.py -text whitespace=cr-at-eol
src/entrega_permutacion.py -text whitespace=cr-at-eol
src/revision_entrega_permutacion.py -text whitespace=cr-at-eol

# Preserve the numerical run, notebook and checksums in Windows/Linux clones.
reports/benchmark_regresion/** -text whitespace=cr-at-eol
reports/benchmark_regresion/figures/*.svg whitespace=-blank-at-eol,cr-at-eol
config/*benchmark* -text whitespace=cr-at-eol
src/*benchmark*.py -text whitespace=cr-at-eol
# This existing dependency was read with CRLF when its run hash was frozen.
# Pin the checkout encoding (including on Linux) without changing its Git blob.
src/comparacion_modelos.py text eol=crlf whitespace=cr-at-eol
docs/benchmark/*.csv -text whitespace=cr-at-eol
notebooks/Comparativa_6_Modelos_Regresion_Pantograficas.ipynb -text whitespace=cr-at-eol
