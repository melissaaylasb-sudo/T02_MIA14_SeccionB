        "max_iter": 20000,
        "tol": 0.0001,
        "selection": "cyclic"
      },
      "proposito": "Contrastar regularización que combina contracción y coeficientes nulos."
    },
    "SVR_RBF": {
      "nombre": "SVR con núcleo RBF",
