      },
      "proposito": "Referencia lineal regularizada ante descriptores geométricos relacionados."
    },
    "ElasticNet": {
      "nombre": "Elastic Net",
      "clase": "sklearn.linear_model.ElasticNet",
      "parametros": {
        "alpha": 0.1,
